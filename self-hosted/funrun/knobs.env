# Limits shared by the conductor (convex-local-backend) and funrun_worker.
# Pinned to the upstream defaults in crates/common/src/knobs.rs so the two
# sides can never drift apart — this file does not tune anything.
TRANSACTION_MAX_NUM_USER_WRITES=16000
TRANSACTION_MAX_USER_WRITE_SIZE_BYTES=16777216
TRANSACTION_MAX_READ_SIZE_ROWS=32000
TRANSACTION_MAX_READ_SIZE_BYTES=16777216
FUNCTION_MAX_ARGS_SIZE=16777216
FUNCTION_MAX_RESULT_SIZE=16777216
ISOLATE_MAX_USER_HEAP_SIZE=67108864
DATABASE_UDF_USER_TIMEOUT_SECONDS=1
V8_ACTION_USER_TIMEOUT_SECS=1800
