    {
      "dot": "cyan",
      "title": "Why a second pool",
      "items": [
        "\"use node\" actions need real Node.js.",
        "Unset FUNRUN_NODE_WORKERS to stay upstream."
      ]
    },
    {
      "dot": "rose",
      "title": "Two origins, two jobs",
      "items": [
        "CALLBACK_ORIGIN: syscalls back to the conductor.",
        "CLOUD_ORIGIN: baked into ctx.storage URLs."
      ]
    },
