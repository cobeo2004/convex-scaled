        "focus": ["client", "conductor", "worker"],
        "note": "The conductor picks a worker and opens one Execute stream per attempt."
      },
      {
        "id": "syscalls",
        "label": "Reads travel back",
        "focus": ["isolate", "funhost", "pg"],
        "note": "The worker has no database, so every read returns to the conductor mid-execution."
