    {
      "dot": "cyan",
      "title": "Routing",
      "items": [
        "pick() hashes the module path, so one module reuses one warm isolate.",
        "It spills to another worker when the first is full or busier."
      ]
    },
    {
      "dot": "amber",
      "title": "What may be retried",
      "items": [
        "Before Started nothing ran, so anything may be re-sent.",
        "After Started only pure work — queries, mutations, deploy — retries."
      ]
    },
    {
      "dot": "rose",
      "title": "When it stops",
      "items": [
        "Refused retries back off 50ms → 2s inside a per-kind budget.",
        "Actions get 30s; user-facing reads fail fast after 1s."
      ]
